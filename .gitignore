# Dependencies — restore with `npm install`.
/node_modules

# Frontend build output.
/dist
/dist-ssr

# Rust build output. Both crates share src-tauri/target (see CARGO_TARGET_DIR in
# scripts/build.ps1).
/src-tauri/target

# Schemas generated by tauri-build on every compile.
/src-tauri/gen/schemas
/src-setup/gen/schemas

# The bundled runtime (a complete FFmpeg + yt-dlp build) is deliberately not part of
# the repository: copy yours into runtime/FFMPEG-9.0 before a release build. Note the
# leading slash — a bare `runtime` would also hide src-tauri/src/runtime, which is
# source code.
/runtime

# Built deliverables: the portable folder and the installer.
/release

# Per-user data written next to the executable (settings, history, favourites, logs,
# temp). Anchored for the same reason as /runtime.
/data

# Runtime logs.
*.log

# Editor and OS noise.
*.local
.DS_Store
Thumbs.db
desktop.ini
.env
.env.local